{
	"extends": "./tsconfig.json",
	"include": ["tailwind.config.ts", "vite.config.ts", "plugins", "scripts"],
	"compilerOptions": {
		"composite": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"types": ["node"],
		"lib": ["ES2022", "DOM"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler"
	}
}
